{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main",
  },
  "assist": {
    "enabled": true,
    "includes": ["**/*.{js,jsx,ts,tsx,json,css,scss,md,mdx}"],
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "on",
      },
    },
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "options": {
            "functions": ["clsx", "cva", "cn"],
          },
        },
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noDuplicateFontNames": "off",
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "off",
      },
      "recommended": true,
    },
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space",
  },
}
